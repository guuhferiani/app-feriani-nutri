# Neon Authentication Endpoint (Better Auth)
VITE_NEON_AUTH_URL=https://<your-neon-project-id>.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth

# Neon Data API Endpoint
VITE_NEON_DATA_API_URL=https://<your-neon-project-id>.apirest.c-2.sa-east-1.aws.neon.tech/neondb/rest/v1

# Neon Postgres Database Connection URL (Serverless)
VITE_NEON_DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require
